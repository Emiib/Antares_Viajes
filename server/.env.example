# Copiá este archivo como server/.env y completá los valores.

# Puerto del backend
PORT=5000

# Secreto para firmar los tokens de sesión (obligatorio en producción).
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Contraseña del admin. En producción usá el HASH (no la password en texto plano):
#   node scripts/hash-password.js "tu-password"
ADMIN_PASSWORD_HASH=
# Solo para desarrollo (si no hay hash). Si se omite, usa "admin123".
# ADMIN_PASSWORD=

# Orígenes permitidos por CORS (separados por coma). Vacío = permite todos (solo dev).
# Ej: CORS_ORIGIN=https://www.antaresviajes.tur.ar
CORS_ORIGIN=

# Sincronizar mayoristas al arrancar el server (repuebla la DB tras un reinicio).
# Poné "false" para desactivarlo. Por defecto: activado.
SYNC_ON_STARTUP=true

# --- Credenciales de mayoristas (una por cada adapter) ---
# EJEMPLO_API_URL=
# EJEMPLO_API_KEY=
