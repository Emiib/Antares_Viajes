# URL base del backend del panel admin.
# Copiá este archivo como .env y ajustá el valor.
#
# Desarrollo local:
VITE_API_URL=http://localhost:5000
#
# Producción (definir en Vercel > Project Settings > Environment Variables):
# VITE_API_URL=https://api.antaresviajes.tur.ar

# --- Analítica (opcional) ---
# Dejar vacías hasta publicar. Si no se definen, no se carga ningún script.
# GA4 (Google Analytics): ID con formato G-XXXXXXXXXX
# VITE_GA_ID=
# Meta Pixel (Facebook/Instagram Ads): ID numérico
# VITE_META_PIXEL_ID=
